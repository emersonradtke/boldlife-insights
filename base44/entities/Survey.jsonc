{
  "name": "Survey",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo da pesquisa"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o/subt\u00edtulo da pesquisa"
    },
    "is_visible": {
      "type": "boolean",
      "description": "Se a pesquisa est\u00e1 vis\u00edvel para o p\u00fablico",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "description": "Ordem de exibi\u00e7\u00e3o (menor = primeiro)"
    },
    "show_brands_section": {
      "type": "boolean",
      "description": "Exibir se\u00e7\u00e3o de marcas e produtos",
      "default": true
    },
    "show_rating_section": {
      "type": "boolean",
      "description": "Exibir se\u00e7\u00e3o de avalia\u00e7\u00e3o",
      "default": true
    },
    "show_associate_code": {
      "type": "boolean",
      "description": "Exibir campo de c\u00f3digo do associado",
      "default": true
    },
    "require_associate_code": {
      "type": "boolean",
      "description": "Tornar c\u00f3digo do associado obrigat\u00f3rio",
      "default": false
    },
    "submit_button_text": {
      "type": "string",
      "description": "Texto do bot\u00e3o de envio"
    },
    "thankyou_title": {
      "type": "string",
      "description": "T\u00edtulo da p\u00e1gina de agradecimento"
    },
    "thankyou_message": {
      "type": "string",
      "description": "Mensagem da p\u00e1gina de agradecimento"
    },
    "label_full_name": {
      "type": "string",
      "description": "Label do campo Nome Completo"
    },
    "label_email": {
      "type": "string",
      "description": "Label do campo E-mail"
    },
    "label_phone": {
      "type": "string",
      "description": "Label do campo Telefone"
    },
    "label_is_associate": {
      "type": "string",
      "description": "Label da pergunta de associado"
    },
    "label_associate_yes": {
      "type": "string",
      "description": "Label op\u00e7\u00e3o Sim (associado)"
    },
    "label_associate_no": {
      "type": "string",
      "description": "Label op\u00e7\u00e3o N\u00e3o (associado)"
    },
    "label_associate_code": {
      "type": "string",
      "description": "Label do c\u00f3digo do associado"
    },
    "placeholder_associate_code": {
      "type": "string",
      "description": "Placeholder do c\u00f3digo do associado"
    },
    "label_brands": {
      "type": "string",
      "description": "Label das marcas desejadas"
    },
    "label_products": {
      "type": "string",
      "description": "Label dos produtos desejados"
    },
    "label_rating": {
      "type": "string",
      "description": "Label da avalia\u00e7\u00e3o"
    },
    "label_comments": {
      "type": "string",
      "description": "Label dos coment\u00e1rios"
    },
    "placeholder_comments": {
      "type": "string",
      "description": "Placeholder dos coment\u00e1rios"
    },
    "section1_title": {
      "type": "string",
      "description": "T\u00edtulo da se\u00e7\u00e3o Dados Pessoais"
    },
    "section2_title": {
      "type": "string",
      "description": "T\u00edtulo da se\u00e7\u00e3o V\u00ednculo"
    },
    "section3_title": {
      "type": "string",
      "description": "T\u00edtulo da se\u00e7\u00e3o Marcas e Produtos"
    },
    "section4_title": {
      "type": "string",
      "description": "T\u00edtulo da se\u00e7\u00e3o Avalia\u00e7\u00e3o"
    },
    "footer_text": {
      "type": "string",
      "description": "Texto do rodap\u00e9"
    }
  },
  "required": [
    "title"
  ]
}