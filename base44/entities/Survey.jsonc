{
  "name": "Survey",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo da pesquisa"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o/subt\u00edtulo da pesquisa"
    },
    "is_visible": {
      "type": "boolean",
      "description": "Se a pesquisa est\u00e1 vis\u00edvel para o p\u00fablico",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "description": "Ordem de exibi\u00e7\u00e3o (menor = primeiro)"
    },
    "show_brands_section": {
      "type": "boolean",
      "description": "Exibir se\u00e7\u00e3o de marcas e produtos",
      "default": true
    },
    "show_rating_section": {
      "type": "boolean",
      "description": "Exibir se\u00e7\u00e3o de avalia\u00e7\u00e3o",
      "default": true
    },
    "show_associate_code": {
      "type": "boolean",
      "description": "Exibir campo de c\u00f3digo do associado",
      "default": true
    },
    "require_associate_code": {
      "type": "boolean",
      "description": "Tornar c\u00f3digo do associado obrigat\u00f3rio",
      "default": false
    },
    "submit_button_text": {
      "type": "string",
      "description": "Texto do bot\u00e3o de envio"
    },
    "thankyou_title": {
      "type": "string",
      "description": "T\u00edtulo da p\u00e1gina de agradecimento"
    },
    "thankyou_message": {
      "type": "string",
      "description": "Mensagem da p\u00e1gina de agradecimento"
    }
  },
  "required": [
    "title"
  ]
}